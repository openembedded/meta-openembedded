From a4a0cbc4659e4979b770a089f5e197dd2d175e9b Mon Sep 17 00:00:00 2001
From: Leon Anavi <leon.anavi@konsulko.com>
Date: Tue, 4 Mar 2025 13:30:48 +0000
Subject: [PATCH] pyproject.toml: Support newer versions

Support newer versions when building through bitbake.

Upstream-Status: Inappropriate [oe specific]

Signed-off-by: Leon Anavi <leon.anavi@konsulko.com>
---
 pyproject.toml | 6 +++---
 1 file changed, 3 insertions(+), 3 deletions(-)

diff --git a/pyproject.toml b/pyproject.toml
index c2c046603..c393d2137 100644
--- a/pyproject.toml
+++ b/pyproject.toml
@@ -1,9 +1,9 @@
 
 [build-system]
 requires = [
-    "hatchling==1.27.0",
-    "hatch-vcs==0.5.0",
-    "hatch-fancy-pypi-readme==25.1.0",
+    "hatchling>=1.27.0",
+    "hatch-vcs>=0.5.0",
+    "hatch-fancy-pypi-readme>=25.1.0"
 ]
 build-backend = "hatchling.build"
 
