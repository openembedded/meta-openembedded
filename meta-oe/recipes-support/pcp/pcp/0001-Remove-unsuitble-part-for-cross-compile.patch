From db9e6a4b7a48dee62fccb662347dd638a2d286d5 Mon Sep 17 00:00:00 2001
From: Lei Maohui <leimaohui@fujitsu.com>
Date: Thu, 2 Dec 2021 14:29:06 +0900
Subject: [PATCH] Remove unsuitble part for cross-compile.

Upstream-Status: Inappropriate [OE specific]

Signed-off-by: Lei Maohui <leimaohui@fujitsu.com>
---
 configure.ac               | 8 +-------
 src/libpcp/src/GNUmakefile | 2 --
 2 files changed, 1 insertion(+), 9 deletions(-)

diff --git a/configure.ac b/configure.ac
--- a/configure.ac
+++ b/configure.ac
@@ -715,13 +715,7 @@ fi
 which=$WHICH
 AC_SUBST(which)
 
-if test -z "$AR"; then
-    AC_PATH_PROGS(AR, [gcc-ar ar], ar)
-fi
-ar=`$which $AR`
-if test ! -x "$ar"; then
-    AC_MSG_ERROR([cannot find a valid 'ar' command.])
-fi
+ar=$AR
 AC_SUBST(ar)
 
 AC_PROG_LEX([noyywrap])
diff --git a/src/libpcp/src/GNUmakefile b/src/libpcp/src/GNUmakefile
--- a/src/libpcp/src/GNUmakefile
+++ b/src/libpcp/src/GNUmakefile
@@ -184,8 +184,6 @@ exports:	exports.in mk.exports
 # consistent in all placess.
 #
 check.done:	$(OBJECTS)
-	./check-statics
-	./check-errorcodes
 	touch check.done
 
 ifneq ($(LIBTARGET),)
