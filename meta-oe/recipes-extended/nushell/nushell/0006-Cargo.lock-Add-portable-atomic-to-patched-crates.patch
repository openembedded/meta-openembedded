From: Khem Raj <khem.raj@oss.qualcomm.com>
Date: Thu, 22 Oct 2026 12:00:00 -0700
Subject: [PATCH] Cargo.lock: Add portable-atomic to patched crates

fff-search, rmcp, nu-command and nu-dap are patched to depend on
portable-atomic on targets without 64-bit atomics. The build uses
--frozen, so record the dependencies in the lock file. portable-atomic
1.13.1 is already locked.

Upstream-Status: Inappropriate [OE-specific, follows the crate patches]
Signed-off-by: Khem Raj <khem.raj@oss.qualcomm.com>
---
 Cargo.lock | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/Cargo.lock b/Cargo.lock
index a621b2f..bc94b5a 100644
--- a/Cargo.lock
+++ b/Cargo.lock
@@ -1625,6 +1625,7 @@ dependencies = [
  "notify 9.0.0-rc.4",
  "parking_lot",
  "pathdiff",
+ "portable-atomic",
  "rayon",
  "regex",
  "regex-syntax",
@@ -3665,6 +3666,7 @@ dependencies = [
  "parse_datetime",
  "pathdiff",
  "percent-encoding",
+ "portable-atomic",
  "print-positions",
  "pure-rust-locales",
  "quick-xml 0.42.0",
@@ -3742,6 +3744,7 @@ dependencies = [
  "nu-protocol",
  "nu-utils",
  "parking_lot",
+ "portable-atomic",
  "serde",
  "serde_json",
  "windows-sys 0.61.2",
@@ -5381,6 +5384,7 @@ dependencies = [
  "libc",
  "pastey",
  "pin-project-lite",
+ "portable-atomic",
  "rand 0.10.2",
  "rmcp-macros",
  "schemars",
