#!/bin/sh
### BEGIN INIT INFO
# Provides:          influxdb3
# Required-Start:    $all
# Required-Stop:     $remote_fs $syslog
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: Start the InfluxDB 3 Core server
### END INIT INFO
# If you modify this, please make sure to also edit influxdb3.service

NAME=influxdb3
DAEMON=/usr/bin/influxdb3
CONFIG=/etc/influxdb3/influxdb3.conf
PIDFILE=/run/influxdb3/influxdb3.pid
LOGFILE=/var/log/influxdb3/influxdb3.log
USER=influxdb3
GROUP=influxdb3
OPEN_FILE_LIMIT=65536

[ -x "$DAEMON" ] || exit 5

if [ ! -r "$CONFIG" ]; then
    echo "config file $CONFIG doesn't exist (or you don't have permission to view)"
    exit 4
fi

# Exported so that 'influxdb3 serve' picks up the remaining settings too.
set -a
. "$CONFIG"
set +a

start() {
    if [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then
        echo "$NAME is already running"
        return 0
    fi
    for dir in "$(dirname "$PIDFILE")" "$(dirname "$LOGFILE")" "$INFLUXDB3_DATA_DIR" "$INFLUXDB3_PLUGIN_DIR"; do
        [ -n "$dir" ] || continue
        mkdir -p "$dir"
        chown "$USER:$GROUP" "$dir"
    done
    ulimit -n $OPEN_FILE_LIMIT

    echo "Starting $NAME..."
    start-stop-daemon --start --quiet --background --make-pidfile \
        --pidfile "$PIDFILE" --chuid "$USER:$GROUP" \
        --startas /bin/sh -- -c "exec $DAEMON serve \
            --node-id '$INFLUXDB3_NODE_ID' \
            --object-store '$INFLUXDB3_OBJECT_STORE' \
            --data-dir '$INFLUXDB3_DATA_DIR' \
            $INFLUXDB3_OPTS >>'$LOGFILE' 2>&1"
}

stop() {
    if [ ! -f "$PIDFILE" ] || ! kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then
        echo "$NAME is already stopped"
        rm -f "$PIDFILE"
        return 0
    fi
    echo "Stopping $NAME..."
    PID="$(cat "$PIDFILE")"
    kill -TERM "$PID"
    n=0
    while kill -0 "$PID" 2>/dev/null; do
        n=$((n + 1))
        if [ $n -gt 30 ]; then
            echo "Timeout exceeded, sending SIGKILL..."
            kill -KILL "$PID"
            break
        fi
        sleep 1
    done
    rm -f "$PIDFILE"
}

status() {
    if [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then
        echo "$NAME is running"
        exit 0
    fi
    echo "$NAME is not running"
    exit 3
}

case "$1" in
    start)
        start
        ;;
    stop)
        stop
        ;;
    restart)
        stop
        start
        ;;
    status)
        status
        ;;
    version)
        $DAEMON --version
        ;;
    *)
        echo "Usage: $0 {start|stop|restart|status|version}"
        exit 2
        ;;
esac
