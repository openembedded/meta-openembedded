From d873c1b2ddf6818e3f814ab7f9c1ae34fe3da847 Mon Sep 17 00:00:00 2001
From: Khem Raj <khem.raj@oss.qualcomm.com>
Date: Mon, 9 Nov 2026 08:37:30 -0800
Subject: [PATCH] Only export getipnodebyname and freehostent where they exist

dlib only interposes getipnodebyname() and freehostent() when the
platform has getipnodebyname() (Solaris), but they are always listed in
the exported symbols, so with glibc linkers that check the version
script, like lld, fail with:

  error: version script assignment of 'global' to symbol 'freehostent' failed: symbol not defined

Leave them out of the symbol list when getipnodebyname() is not found.

Upstream-Status: Pending
Signed-off-by: Khem Raj <khem.raj@oss.qualcomm.com>
---
 mapfile.m4 | 8 +++++++-
 1 file changed, 7 insertions(+), 1 deletion(-)

diff --git a/mapfile.m4 b/mapfile.m4
index 644a94b..5daa801 100644
--- a/mapfile.m4
+++ b/mapfile.m4
@@ -13,7 +13,13 @@ if test x"$sol64" = xt; then
    PLDDIRS="$PLDDIRS dlib64/"
 fi
 for symdir in $PLDDIRS; do
-    cat include/symbols_preload.txt >> $symdir/$MAPFILE
+    #getipnodebyname() and freehostent() are only interposed where they exist
+    if test x"$ac_cv_func_getipnodebyname" = xyes; then
+	cat include/symbols_preload.txt >> $symdir/$MAPFILE
+    else
+	grep -v -e '^freehostent$' -e '^getipnodebyname$' \
+	    include/symbols_preload.txt >> $symdir/$MAPFILE
+    fi
 
     #platform dependent symbols
     case $host in
